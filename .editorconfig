root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 把不带 BOM 的脚本当成系统代码页（中文系统是 GBK）来读，中文会变成乱码、脚本解析失败
[*.ps1]
charset = utf-8-bom
